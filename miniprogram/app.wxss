/* app.wxss — 全局样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

.header {
  background: linear-gradient(135deg, #07c160 0%, #2ecc71 100%);
  padding: 40rpx 30rpx;
  color: white;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.family-list {
  background-color: white;
  margin: 30rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  font-size: 28rpx;
  color: #07c160;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background-color: #e8f8e8;
}

.member-scroll {
  width: 100%;
  white-space: nowrap;
}

.member-cards {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 0;
}

.member-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 20rpx;
  width: 160rpx;
  position: relative;
  transition: all 0.2s;
}

.member-card.active {
  background-color: #07c160;
  transform: scale(1.05);
}

.member-card.active .member-name,
.member-card.active .member-relation {
  color: white;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-bottom: 10rpx;
  background-color: #ddd;
}

.member-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.member-relation {
  font-size: 22rpx;
  color: #999;
}

.member-status {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background-color: #07c160;
}

.health-data {
  margin: 30rpx;
}

.health-card {
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.update-time {
  font-size: 24rpx;
  color: #999;
}

.refresh-btn {
  background-color: #f0f0f0;
  color: #666;
  font-size: 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
}

.risk-level {
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.risk-level.high {
  background-color: #fff2f2;
  border-left: 8rpx solid #ff6b6b;
}

.risk-level.moderate {
  background-color: #fff7e6;
  border-left: 8rpx solid #ffa500;
}

.risk-level.normal {
  background-color: #e8f8e8;
  border-left: 8rpx solid #07c160;
}

.risk-tag {
  font-size: 30rpx;
  font-weight: bold;
}

.risk-score {
  font-size: 28rpx;
  color: #666;
}

.emergency-alert {
  background-color: #ff6b6b;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  color: white;
}

.alert-title {
  font-size: 34rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.alert-message {
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.alert-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 28rpx;
  border-radius: 35rpx;
  margin: 0;
}

.action-btn.call {
  background-color: white;
  color: #ff6b6b;
}

.action-btn.message {
  background-color: rgba(255, 255, 255, 0.2);
  color: white;
  border: 2rpx solid white;
}

.advice-section, .reminder-section, .action-items {
  margin-bottom: 30rpx;
}

.advice-title, .reminder-title, .action-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
}

.advice-content, .reminder-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.reminder-item {
  background-color: #f8f8f8;
  padding: 20rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reminder-frequency {
  font-size: 24rpx;
  color: #07c160;
  background-color: #e8f8e8;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.action-list {
  background-color: #f8f8f8;
  padding: 20rpx;
  border-radius: 12rpx;
}

.action-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.action-item:last-child {
  margin-bottom: 0;
}

.action-dot {
  color: #07c160;
  margin-right: 10rpx;
  font-size: 28rpx;
}

.action-text {
  font-size: 28rpx;
  color: #666;
  flex: 1;
}

.vital-signs {
  display: flex;
  gap: 30rpx;
  margin-bottom: 30rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid #eee;
  border-bottom: 2rpx solid #eee;
}

.vital-item {
  flex: 1;
  text-align: center;
}

.vital-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}

.vital-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.trend-section {
  margin-bottom: 20rpx;
}

.trend-title {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.trend-chart {
  background-color: #fafafa;
  padding: 30rpx;
  border-radius: 12rpx;
}

.chart-bars {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.bar {
  width: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bar-fill {
  width: 40rpx;
  background: linear-gradient(to top, #07c160, #2ecc71);
  border-radius: 20rpx 20rpx 0 0;
  margin-bottom: 10rpx;
}

.bar-value {
  font-size: 24rpx;
  color: #666;
}

.chart-labels {
  display: flex;
  justify-content: space-around;
  color: #999;
  font-size: 24rpx;
}

.history-section {
  background-color: white;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eee;
}

.history-item:last-child {
  border-bottom: none;
}

.history-date {
  font-size: 28rpx;
  color: #666;
  width: 100rpx;
}

.history-bp {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
  text-align: center;
}

.history-status {
  font-size: 26rpx;
  width: 120rpx;
  text-align: right;
}

.history-status.high {
  color: #ff6b6b;
}

.history-status.moderate {
  color: #ffa500;
}

.history-status.normal {
  color: #07c160;
}

.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.quick-btn {
  flex: 1;
  background-color: white;
  color: #666;
  font-size: 26rpx;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  border: 2rpx solid #eee;
  margin: 0;
  padding: 0;
}

.quick-btn:active {
  background-color: #f5f5f5;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.add-family-btn {
  background-color: #07c160;
  color: white;
  font-size: 28rpx;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  padding: 0 50rpx;
}