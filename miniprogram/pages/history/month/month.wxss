/* pages/history/month/month.wxss */

page {
  background: #F6F7F9;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
}

.container {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ── 图表区域 ── */
.chart-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 0 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  display: block;
}

.chart-sub {
  font-size: 20rpx;
  color: #aaa;
  display: block;
  margin-top: 4rpx;
}

.legend {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-end;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #666;
  gap: 6rpx;
}

.line-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

/* 图表主体 */
.chart-body {
  display: flex;
  align-items: flex-start;
  height: 300px;
}

.y-axis-canvas {
  width: 48px;
  height: 300px;
  flex-shrink: 0;
}

.chart-canvas {
  height: 300px;
  display: block;
}

.chart-empty {
  text-align: center;
  padding: 40rpx;
  color: #bbb;
  font-size: 28rpx;
}

/* ── 稳态偏离分布统计 ── */
.stats-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-val {
  font-size: 40rpx;
  font-weight: 900;
  color: #222;
  line-height: 1.2;
}

.stat-val.stable      { color: #07C160; }
.stat-val.mild        { color: #52c41a; }
.stat-val.moderate    { color: #faad14; }
.stat-val.significant { color: #ff4d4f; }

.stat-label {
  font-size: 20rpx;
  color: #666;
  font-weight: 600;
  margin-top: 6rpx;
}

.stat-sub {
  font-size: 17rpx;
  color: #bbb;
  margin-top: 4rpx;
  line-height: 1.4;
}

/* ★ 新增：60天窗口之外的历史记录概括 */
.older-summary {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.older-summary-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #666;
}

.older-summary-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

/* ── 历史列表 ── */
.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 16rpx;
  display: block;
  padding-left: 4rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}

.item-left {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.date-text {
  font-size: 28rpx;
  color: #444;
  font-weight: 600;
}

.deviation-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  align-self: flex-start;
  font-weight: 600;
}

.deviation-tag.stable      { color: #07C160; background: #E8F7F0; }
.deviation-tag.mild        { color: #52c41a; background: #f6ffed; }
.deviation-tag.moderate    { color: #faad14; background: #fffbe6; }
.deviation-tag.significant { color: #ff4d4f; background: #fff1f0; }
.deviation-tag.critical    { color: #fff;    background: #ff4d4f; }
.deviation-tag.unknown     { color: #999;    background: #f5f5f5; }

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.bp-row-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.bp-val {
  font-size: 40rpx;
  font-weight: 900;
  color: #000;
}

.bp-unit {
  font-size: 20rpx;
  color: #999;
}

.pp-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.pp-label {
  font-size: 20rpx;
  color: #bbb;
}

.pp-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #7B68EE;
}

.pp-unit {
  font-size: 18rpx;
  color: #bbb;
}

.hr-val {
  font-size: 22rpx;
  color: #888;
}

/* ── 空状态 ── */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #bbb;
}

/* ── 返回按钮 ── */
.btn-area {
  margin-top: 40rpx;
}

.back-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #fff;
  color: #333;
  font-size: 32rpx;
  border-radius: 48rpx;
  border: 2rpx solid #ddd;
}
