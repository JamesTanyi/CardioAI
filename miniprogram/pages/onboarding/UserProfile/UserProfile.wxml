<wxs module="utils">
  module.exports.includes = function(arr, item) {
    return arr.indexOf(item) > -1;
  }
  module.exports.hasOther = function(arr) {
    for (var i = 0; i < arr.length; i++) {
      if (arr[i].indexOf('其他') === 0) return true;
    }
    return false;
  }
</wxs>

<view class="container">
  <view class="header">
    <text class="title">{{isLocked ? '个人档案' : '用户注册'}}</text>
    <text class="subtitle">{{isLocked ? '注册信息已锁定，不可更改' : '请完整填写注册信息'}}</text>
  </view>

  <view class="card">
    <view class="form-item">
      <text class="label">姓名</text>
      <input
        class="input {{isLocked ? 'locked' : ''}}"
        placeholder="请输入您的姓名"
        placeholder-class="placeholder"
        bindinput="onInputName"
        value="{{name}}"
        disabled="{{isLocked}}"
      />
      <text wx:if="{{isLocked}}" class="lock-icon">🔒</text>
    </view>
    <view class="divider"></view>

    <!-- ★ 改：出生日期区域重新排版——
    <!-- ★ 改：去掉占位符示例数字——年/月/日单位字已经足够说明每个框的用途，
         示例数字容易让人误以为已经填了值，实际输入框仍是空的 -->
    <view class="form-item birth-item">
      <text class="label">出生日期 <text class="required">(必填)</text></text>

      <view class="birth-fill-blank-container" style="display: flex; align-items: center; gap: 8rpx; margin-top: 16rpx;">
        <input
          type="number"
          value="{{birthYear}}"
          bindinput="onInputYear"
          disabled="{{isLocked}}"
          class="input {{isLocked ? 'locked' : ''}}"
          maxlength="4"
          style="width: 140rpx; text-align: center; border: 1rpx solid #e0e0e0; border-radius: 8rpx; height: 1.8rem; padding: 0;"
        />
        <text style="font-size: 28rpx; color: #333;">年</text>

        <input
          type="number"
          value="{{birthMonth}}"
          bindinput="onInputMonth"
          disabled="{{isLocked}}"
          class="input {{isLocked ? 'locked' : ''}}"
          maxlength="2"
          style="width: 90rpx; text-align: center; border: 1rpx solid #e0e0e0; border-radius: 8rpx; height: 1.8rem; padding: 0;"
        />
        <text style="font-size: 28rpx; color: #333;">月</text>

        <input
          type="number"
          value="{{birthDay}}"
          bindinput="onInputDay"
          disabled="{{isLocked}}"
          class="input {{isLocked ? 'locked' : ''}}"
          maxlength="2"
          style="width: 90rpx; text-align: center; border: 1rpx solid #e0e0e0; border-radius: 8rpx; height: 1.8rem; padding: 0;"
        />
        <text style="font-size: 28rpx; color: #333;">日</text>
      </view>
      <text wx:if="{{isLocked}}" class="lock-icon">🔒</text>
    </view>
    <view class="divider"></view>

    <view class="form-item">
      <text class="label">年龄 <text class="required">(必填)</text></text>
      <input
        class="input"
        type="number"
        placeholder="自动测算或输入"
        placeholder-class="placeholder"
        bindinput="onInputAge"
        value="{{age}}"
      />
    </view>
    <view class="divider"></view>

    <view class="form-item">
      <text class="label">性别 <text class="required">(必填)</text></text>
      <view class="gender-group">
        <view class="gender-btn {{gender === 'male' ? 'active' : ''}}" bindtap="onSelectGender" data-gender="male">男</view>
        <view class="gender-btn {{gender === 'female' ? 'active' : ''}}" bindtap="onSelectGender" data-gender="female">女</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">既往病史</view>
    <view class="tags-container">
      <block wx:for="{{['高血压', '糖尿病', '冠心病', '高血脂', '吸烟', '心肌梗死', '心律失常/房颤', '心力衰竭', '脑卒中(中风)', '心脏支架/搭桥手术史']}}" wx:key="*this">
        <view class="tag {{utils.includes(healthHistory, item) ? 'selected' : ''}}" bindtap="onToggleHealth" data-item="{{item}}">{{item}}</view>
      </block>
      <view class="tag {{utils.hasOther(healthHistory) ? 'selected' : ''}}" bindtap="onToggleOther">其他</view>
    </view>
  </view>

  <block wx:if="{{isLocked}}">
    <button class="btn-submit" bindtap="goHome">进入系统</button>
  </block>

  <block wx:if="{{!isLocked}}">
    <view class="disclaimer">
      <text>免责条款：本程序提供的分析结果仅供参考，不作为医疗诊断依据。如有身体不适，请务必及时线下就医。</text>
    </view>
    <view class="agreement-box" bindtap="onToggleAgreement">
      <view class="checkbox {{agreed ? 'checked' : ''}}">
        <text wx:if="{{agreed}}" class="checkmark">✔</text>
      </view>
      <text class="agreement-text">我已阅读并同意免责条款</text>
    </view>
    <button class="btn-submit {{agreed ? '' : 'disabled'}}" bindtap="onSubmit">进入系统</button>
  </block>

</view>
