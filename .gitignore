# Python 虚拟环境——几十上百MB，且每台电脑各自生成，不该进版本库
venv/
.venv/
env/

# Python 运行时缓存
__pycache__/
*.pyc
*.pyo

# 本地调试用的SQLite数据库——只在USE_LOCAL_DEBUG本地环境用，
# 里面是测试数据(T001/T002/T003那批)，不该跟正式代码混在一起提交
bloodtrack.db
cardioai.db
*.db

# 常见的IDE/系统临时文件
.vscode/
.idea/
.DS_Store
Thumbs.db

# 微信开发者工具的"个人本地配置"——文件名里的private就是这个意思，
# 每个人电脑上内容不一样，不该进版本库
project.private.config.json

# DB Browser for SQLite 打开数据库时自动生成的会话文件，纯本地产物
*.sqbpro

# 如果项目里有生成的报告图片等临时产物，也排除掉(按实际情况调整)
static/reports/*.png